PORT=5005

DATABASE_URL=postgresql://user:password@localhost:5432/blurasaga?schema=public

JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=24h

BLUGATE_BASE_URL=https://blugate.blurasaga.com
# Optional — Tools → News gateway (defaults to BLUGATE_BASE_URL + /api/gateway/news-api)
# BLUGATE_NEWS_HOST=https://blugate.blurasaga.com/api/gateway/news-api

SCRAPE_API_URL=http://your-server:8000/scrape
OSINT_API_URL=http://your-server:8000/osint
BLUWEB_API_URL=http://your-server:8000

CUSTOM_SENTIMENT_URL=http://your-server:8003
OCR_SERVICE_URL=http://your-server:8000

# Event hashtag generator (PM2: event-hashtag-generator on :2001)
EVENT_HASHTAG_GENERATOR_URL=http://127.0.0.1:2001
# EVENT_HASHTAG_GENERATOR_TIMEOUT_MS=120000

LLM_BASE_URL=http://your-server/v1
LLM_API_KEY=
LLM_MODEL=qwen3-14b

# LOG_LEVEL=info
# Optional fallback only (jobs/scripts with no HTTP request).
# Live uploads/media/PDFs use each tenant's request Host / X-Forwarded-Host.
# PUBLIC_BACKEND_URL=https://your.domain
# TENANT_PROVISION_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# PLATFORM_SECRETS_KEY=
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_EMAIL=superadmin@example.com
# SUPERADMIN_NAME=Super Administrator
# SUPERADMIN_PASSWORD=
# ALLOW_DEFAULT_ADMIN=false
