PORT=5005

DATABASE_URL=postgresql://user:password@localhost:5432/blurasaga?schema=public

JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=24h

BLUGATE_BASE_URL=https://blugate.blurasaga.com
# Optional — Tools → News gateway (defaults to BLUGATE_BASE_URL + /api/gateway/news-api)
# BLUGATE_NEWS_HOST=https://blugate.blurasaga.com/api/gateway/news-api

SCRAPE_API_URL=http://127.0.0.1:8000/scrape
OSINT_API_URL=http://127.0.0.1:8000/osint
BLUWEB_API_URL=http://127.0.0.1:8000/scrape

# E-Paper service (Tools → E-Paper). Proxied at /api/epaper/*
EPAPER_URL=http://127.0.0.1:8088
# EPAPER_TIMEOUT_MS=60000
# EPAPER_LONG_TIMEOUT_MS=600000

CUSTOM_SENTIMENT_URL=http://your-server:8003
OCR_SERVICE_URL=http://your-server:8000

# Event hashtag generator (PM2: event-hashtag-generator on :2001)
EVENT_HASHTAG_GENERATOR_URL=http://127.0.0.1:2001
# EVENT_HASHTAG_GENERATOR_TIMEOUT_MS=120000

LLM_BASE_URL=http://your-server/v1
LLM_API_KEY=
LLM_MODEL=qwen3-14b
# AI Assistant (/ai-assistant) uses the same LLM_* settings for RAG answers.
# LLM_CHAT_TIMEOUT_MS=120000
# LLM_CHAT_MAX_TOKENS=2000

# Per-tenant embeddings.chunks vector width (pgvector). Set before first ensure.
# Changing later requires a reindex migration — do not flip casually.
# In-DB embeddings via pg_gembed (MiniLM = 384). Change only before first chunks create.
# EMBEDDING_DIMENSIONS=384
# EMBEDDING_BACKEND=embed_anything
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Per-tenant embeddings.chunks vector width (pgvector). Set before first ensure.
# Changing later requires a reindex migration — do not flip casually.
# EMBEDDING_DIMENSIONS=1536

# LOG_LEVEL=info
# Optional fallback only (jobs/scripts with no HTTP request).
# Live uploads/media/PDFs use each tenant's request Host / X-Forwarded-Host.
# PUBLIC_BACKEND_URL=https://your.domain

# Iframe embedding: authorized parents live in deploy/sites.json → frame_ancestors
# (nginx CSP). Never use *. Cross-site iframe auth on HTTPS: SameSite=None; Secure
# COOKIE_CROSS_SITE=true
# TENANT_PROVISION_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# PLATFORM_SECRETS_KEY=
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_EMAIL=superadmin@example.com
# SUPERADMIN_NAME=Super Administrator
# SUPERADMIN_PASSWORD=
# ALLOW_DEFAULT_ADMIN=false
